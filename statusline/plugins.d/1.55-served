#!/bin/bash
# Segment: which model ACTUALLY served the last turn, plus its cache state.
#
# WHY THIS EXISTS. The statusline payload's `model.id` is CLIENT-SIDE CONFIG —
# it is whatever you picked in /model, not what answered. Those are the same
# thing until you point ANTHROPIC_BASE_URL at a gateway, and then they are not:
# a LiteLLM router advertises one alias (`claude-smart-router`) and fans out to
# several upstreams behind it, so the payload keeps saying the alias while a
# different model does the work. 1.50-model shows the pick; this shows the pick's
# consequence.
#
# WHERE THE TRUTH COMES FROM. The payload also carries `transcript_path`, and
# each assistant record in that JSONL has a `message.model` written from the
# RESPONSE, not from config. Proven by the disagreement: a session that selected
# `claude-smart-router` recorded `openai.gpt-oss-120b-1:0` — a string the client
# never held and could not have invented.
#
# ⚠ THIS IS A SCRAPE OF AN UNDOCUMENTED FORMAT. The statusline docs' field list
# does not include the serving model; reading the transcript is inference from
# file shape, and the shape can change in any release. Hence the error marker
# rather than silence (see below) — if this starts lying, it should say so.
#
# LAGS BY ONE TURN. The statusline renders before the assistant record is
# written, so this describes the PREVIOUS turn. That is fine for the question it
# answers ("what am I actually talking to"), because session affinity pins a
# conversation to one model anyway — see the session_affinity notes in
# ops/platform/cloudflare/litellm/config-both-tiers.yaml in the dscout repo.

input="${CLAUDE_STATUS_INPUT:-/tmp/claude-status-input.json}"

muted_green="\033[2;32m"
muted_yellow="\033[2;33m"
muted_red="\033[2;31m"
color_reset="\033[2;37m"
dim="\033[38;5;238m"

transcript=$(super -f line -c 'coalesce(transcript_path, "")' "$input" 2>/dev/null)

# No transcript path, or it is not there yet on a brand-new session. Not an
# error — there is genuinely nothing to report, so say nothing.
[[ -n "$transcript" && -f "$transcript" ]] || exit 0

# Last assistant turn: the model that answered, what it read from cache, and how
# much input it was billed. One pass, last record wins.
# NB: no coalesce on message.model — a nested \"\" inside an f-string is a
# SuperSQL parse error, and an assistant record always carries the field. The
# empty-$served guard below covers it if that ever stops being true.
row=$(super -f line -c '
  where message.role=="assistant"
  | tail 1
  | values f"{message.model}|{coalesce(message.usage.cache_read_input_tokens,0)}|{coalesce(message.usage.input_tokens,0)}"
' "$transcript" 2>/dev/null)

# The scrape broke: file unreadable, or the shape moved under us. Show a marker
# instead of nothing, so a silently-wrong statusline is distinguishable from a
# quiet one. Not a hard failure — this is a status bar, not a test.
if [[ -z "$row" ]]; then
  # A transcript with no assistant turn yet is the ordinary first-prompt case,
  # not a format break. Only complain when there IS content we could not read.
  if [[ -s "$transcript" ]] && grep -q '"assistant"' "$transcript" 2>/dev/null; then
    echo -e "${muted_red}served:?${color_reset}"
  fi
  exit 0
fi

IFS='|' read -r served cache_read input_tokens <<<"$row"

[[ -n "$served" ]] || { echo -e "${muted_red}served:?${color_reset}"; exit 0; }

# Strip the provider prefix that gateways prepend (bedrock/, openai/, @cf/...);
# the family is what matters at a glance and the bar is narrow.
short="${served##*/}"

# Cache state. Zero reads on a substantial context means the whole prompt is
# being re-billed every turn — the thing that made the open-weight tier's cost
# case collapse. Worth seeing without digging.
if [[ "$cache_read" -gt 0 ]] 2>/dev/null; then
  cache_marker="${muted_green}⚡${color_reset}"
elif [[ "${input_tokens:-0}" -gt 10000 ]] 2>/dev/null; then
  # Big prompt, nothing cached: this turn paid full freight.
  cache_marker="${muted_yellow}∅${color_reset}"
else
  # Small prompt with no cache is unremarkable.
  cache_marker=""
fi

if [[ -n "$cache_marker" ]]; then
  echo -e "${dim}via${color_reset} ${short} ${cache_marker}"
else
  echo -e "${dim}via${color_reset} ${short}"
fi
