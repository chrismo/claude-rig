#!/bin/bash
#
# claude-tabs - Save and restore Ghostty Claude Code sessions
#
# Usage: claude-tabs save          Save active sessions to manifest
#        claude-tabs restore       Restore sessions from manifest
#        claude-tabs list-active   Show running sessions (dry-run of save)
#        claude-tabs list-saved    Show the saved manifest (what restore uses)
#
# Detection: No registration or state files. Asks the system what's running
# via `lsof -c node -a -d cwd -Fn`, which returns the cwd of every node
# process. Claude Code runs as node, so each session appears here.
#
# Cross-references each unique cwd with ~/.claude/projects/<encoded-path>/
# to filter out non-Claude node processes (e.g. dev servers). The most
# recently modified .jsonl in the project dir gives the session UUID.
#
# Path encoding: /Users/chris/dev/ds5 → -Users-chris-dev-ds5
# Resume: `claude --resume <session-id>` resumes by UUID.
#
# Manifest: ~/.claude/tab-state.json (JSON array of {name, path, session_id})
#
# Known limitations:
#   - Pane layout is lost. lsof sees processes, not terminal geometry.
#     Sessions in Ghostty panes (splits) are detected and saved correctly,
#     but restore opens each as a separate tab.
#   - Multiple sessions in the same directory: each running PID gets its own
#     row, paired with one of the K most recently modified JSONLs (by mtime
#     rank). The PID→session mapping isn't preserved — Claude doesn't keep
#     the JSONL open — but on restore each tab gets a real, distinct session.
#   - Stale session UUIDs: `claude --resume` with an invalid UUID should
#     fail gracefully or start fresh.
#   - Resuming an active session: `claude --resume` does not error — it
#     creates a second writer to the same JSONL. Both instances interleave
#     on disk but are oblivious to each other in-memory. Not destructive,
#     but not the intended workflow (save → kill Ghostty → restore).
#   - Restore adds tabs; it doesn't replace existing ones. Kill Ghostty
#     first for a clean slate.
#   - Incomplete detection from non-interactive contexts. Observed 2026-06-03:
#     `claude-tabs save` run from the Stop hook (or any claude-spawned
#     subprocess) sometimes cannot see running `claude` CLI processes via
#     `pgrep` — even with the sandbox disabled — while the same command from an
#     interactive shell sees them all. When that happens, detection yields `[]`
#     and `save` overwrites a good manifest with empty. Root cause unconfirmed
#     (argv visibility / process-tree context — theory, not verified).
#     Recovery: every save is also archived to the history dir, so the last
#     good snapshot survives; and `work-context` (the worktree walk) can
#     reconstruct active work to get back on track.
#     TODO: guard `cmd_save` so it never replaces a populated manifest with an
#     empty detection result (add a `--allow-empty` escape hatch for the
#     intentional "record nothing" case).
#
# Restore uses Ghostty's native scripting (Ghostty 1.3+) — `new tab`,
# `input text to terminal`, `send key "enter" to terminal` — instead of
# clipboard+keystroke routing through System Events. This avoids focus races
# where a paste meant for a new tab landed in the prior tab's claude prompt.
#
# Pane-aware restore is possible but unimplemented: the dictionary exposes
# `split direction:right/left/down/up` on terminals, so save could enumerate
# terminals-per-tab and restore could create splits. Panes are typically temp
# helpers, so tabs-only remains the practical choice.
# See also: ghostty-workspace (YAML-driven layouts via AppleScript).
#

set -euo pipefail

CLAUDE_TABS_PROJECTS_DIR="${CLAUDE_TABS_PROJECTS_DIR:-$HOME/.claude/projects}"
CLAUDE_TABS_MANIFEST="${CLAUDE_TABS_MANIFEST:-$HOME/.claude/tab-state.json}"
CLAUDE_TABS_HISTORY_DIR="${CLAUDE_TABS_HISTORY_DIR:-$HOME/.claude/tab-history}"

# ─────────────────────────────────────────────────────────────────────────────
# Functions (sourced by tests)
# ─────────────────────────────────────────────────────────────────────────────

encode_project_path() {
  local path="$1"
  # Strip trailing slash
  path="${path%/}"
  # Replace / with -
  echo "${path//\//-}"
}

# detect_sessions <lsof_output>
# Parses lsof -Fn output, cross-references with projects dir, returns JSON array.
# Each active PID gets its own row — when K processes share a cwd, the K most
# recently modified JSONLs in that project dir are paired up (rank by mtime).
detect_sessions() {
  local lsof_output="$1"
  local entries=()

  # Per-cwd counter: how many PIDs we've seen so far at this cwd.
  # Bash 3 has no associative arrays, so use parallel-array lookup.
  local seen_cwds=()
  local seen_counts=()

  # Extract cwds in order, one per PID (do NOT dedupe — duplicates mean
  # multiple active sessions in the same directory).
  local cwds
  cwds=$(echo "$lsof_output" | grep '^n' | sed 's/^n//')

  while IFS= read -r cwd; do
    if [[ -z "$cwd" ]]; then
      continue
    fi

    local encoded
    encoded=$(encode_project_path "$cwd")
    local project_dir="$CLAUDE_TABS_PROJECTS_DIR/$encoded"

    if [[ ! -d "$project_dir" ]]; then
      continue
    fi

    # Find this cwd's current count, then bump it.
    local rank=0 i=0 found=0
    for ((i = 0; i < ${#seen_cwds[@]}; i++)); do
      if [[ "${seen_cwds[i]}" == "$cwd" ]]; then
        rank="${seen_counts[i]}"
        seen_counts[i]=$((rank + 1))
        found=1
        break
      fi
    done
    if [[ "$found" -eq 0 ]]; then
      seen_cwds+=("$cwd")
      seen_counts+=(1)
    fi

    # Pick the (rank+1)th most recent JSONL — `ls -t` is newest-first,
    # `sed -n "Np"` gets row N (1-indexed).
    local jsonl
    jsonl=$(ls -t "$project_dir"/*.jsonl 2>/dev/null | sed -n "$((rank + 1))p")
    if [[ -z "$jsonl" ]]; then
      continue
    fi

    local session_id
    session_id=$(basename "$jsonl" .jsonl)
    local name
    name=$(basename "$cwd")

    entries+=("{\"name\": \"$name\", \"path\": \"$cwd\", \"session_id\": \"$session_id\"}")
  done <<< "$cwds"

  # Build JSON array
  if [[ ${#entries[@]} -eq 0 ]]; then
    echo "[]"
    return 0
  fi

  local json="["
  local first=true
  for entry in "${entries[@]}"; do
    if [[ "$first" == true ]]; then
      first=false
    else
      json+=","
    fi
    json+=$'\n  '"$entry"
  done
  json+=$'\n]'
  echo "$json"
}

get_lsof_output() {
  if [[ -n "${CLAUDE_TABS_LSOF_OUTPUT:-}" ]]; then
    echo "$CLAUDE_TABS_LSOF_OUTPUT"
    return 0
  fi

  # Find each running Claude session's PID. We can't use `lsof -c claude` —
  # macOS lsof reports the binary's truncated kernel comm (e.g. "2.1.126"),
  # not "claude" — and `lsof -c node` over-counts because each session forks
  # MCP server children (npm exec + node).
  local pids
  pids=$(pgrep -f '^claude($| )' 2>/dev/null || true)
  if [[ -z "$pids" ]]; then
    return 0
  fi

  # lsof -p takes a comma-separated PID list.
  local pid_list
  pid_list=$(echo "$pids" | tr '\n' ',' | sed 's/,$//')

  lsof -p "$pid_list" -a -d cwd -Fpn 2>/dev/null || true
}

cmd_save() {
  local lsof_output
  lsof_output=$(get_lsof_output)

  local json
  json=$(detect_sessions "$lsof_output")

  if [[ "$json" == "[]" ]]; then
    echo "[]" > "$CLAUDE_TABS_MANIFEST"
  else
    echo "$json" | super -J -c 'unnest this | sort name | collect(this)' - > "$CLAUDE_TABS_MANIFEST"
  fi

  # Copy to history
  mkdir -p "$CLAUDE_TABS_HISTORY_DIR"
  cp "$CLAUDE_TABS_MANIFEST" "$CLAUDE_TABS_HISTORY_DIR/tab-state-$(date +%Y%m%d-%H%M%S).json"

  local count
  count=$(echo "$json" | super -f line -c 'unnest this | count()' -)
  echo "Saved $count sessions to $CLAUDE_TABS_MANIFEST"
}

# list-active: what's running right now (the set `save` would capture).
# Detects live `claude` processes — does NOT read the manifest.
cmd_list_active() {
  local lsof_output
  lsof_output=$(get_lsof_output)

  local json
  json=$(detect_sessions "$lsof_output")

  if [[ "$json" == "[]" ]]; then
    return 0
  fi

  echo "$json" | super -J -c 'unnest this | sort name | collect(this)' - | grdy
}

# list-saved: what's in the manifest (the set `restore` would reopen).
# Reads the manifest file — does NOT inspect live processes.
cmd_list_saved() {
  if [[ ! -f "$CLAUDE_TABS_MANIFEST" ]]; then
    echo "No saved manifest at $CLAUDE_TABS_MANIFEST"
    return 0
  fi

  local content
  content=$(cat "$CLAUDE_TABS_MANIFEST")
  if [[ -z "$content" || "$content" == "[]" ]]; then
    echo "Saved manifest is empty: $CLAUDE_TABS_MANIFEST"
    return 0
  fi

  super -J -c 'unnest this | sort name | collect(this)' "$CLAUDE_TABS_MANIFEST" | grdy
}

build_restore_applescript() {
  local cmd_dir="$1"
  local count="$2"

  # Uses Ghostty's native scripting commands (Ghostty 1.3+):
  #   - `new tab in window`   — returns a tab object directly, no focus race
  #   - `input text ... to terminal`  — delivers to a specific terminal surface
  #   - `send key "enter" to terminal` — Enter to that same terminal
  #
  # The old implementation routed cmd+v through System Events, which delivered
  # to whatever tab happened to be frontmost when the keystroke landed. Under
  # load, the new tab hadn't taken focus yet and the paste ended up in the
  # prior tab where `claude` was already booting.
  #
  # Note: we keep `tell application "Ghostty"` blocks small and avoid using
  # any identifier that might collide with terminology Ghostty's dictionary
  # loads into scope (e.g. `date`, `time`).
  #
  # `tell application "Ghostty" to activate` does NOT reliably open a window:
  # launching Ghostty cold (or waking it from a backgrounded, zero-window
  # state) leaves it running with no windows. So we don't wait for a window to
  # appear — we ask the scripting dictionary for one with `new window` when the
  # count is zero, and reuse that fresh window's default tab for cmd-0.
  cat <<EOF
on readCmd(cmdFile)
    return do shell script "cat " & quoted form of cmdFile
end readCmd

on sendToTerminal(term, cmdFile)
    set cmdText to my readCmd(cmdFile)
    tell application "Ghostty"
        input text cmdText to term
        send key "enter" to term
    end tell
end sendToTerminal

set cmdDir to "${cmd_dir}"
set sessionCount to ${count}

tell application "Ghostty" to activate

-- Acquire a target window. If Ghostty has no windows (cold launch, or a
-- backgrounded zero-window state), create one and reuse its default tab for
-- cmd-0 so we don't strand an empty shell. If a window already exists, add
-- our tabs to it without disturbing the user's existing tabs.
tell application "Ghostty"
    if (count of windows) is 0 then
        set targetWindow to (new window)
        set reuseFirstTab to true
    else
        set targetWindow to front window
        set reuseFirstTab to false
    end if
end tell

set startIdx to 0
if reuseFirstTab then
    -- Give the freshly created window's shell a moment to come up before we
    -- paste into it.
    delay 0.3
    tell application "Ghostty"
        set firstTerm to terminal 1 of tab 1 of targetWindow
    end tell
    my sendToTerminal(firstTerm, cmdDir & "/cmd-0.txt")
    set startIdx to 1
end if

repeat with i from startIdx to (sessionCount - 1)
    tell application "Ghostty"
        set newT to new tab in targetWindow
        set newTerm to terminal 1 of newT
    end tell
    my sendToTerminal(newTerm, cmdDir & "/cmd-" & i & ".txt")
end repeat
EOF
}

cmd_restore() {
  local manifest="${1:-$CLAUDE_TABS_MANIFEST}"

  if [[ ! -f "$manifest" ]]; then
    echo "Manifest not found: $manifest"
    return 1
  fi

  local count
  count=$(super -f line -c 'unnest this | count()' "$manifest")
  echo "Restoring $count sessions from $manifest"

  # Write per-session command files
  local cmd_dir="${CLAUDE_TABS_CMD_DIR:-$(mktemp -d "${TMPDIR:-/tmp}/claude-tabs-restore.XXXXXX")}"
  mkdir -p "$cmd_dir"

  local i=0
  while IFS=, read -r path session_id; do
    if [[ -n "${CLAUDE_TABS_DRY_RUN:-}" ]]; then
      echo "claude-slot $path --resume $session_id"
    else
      local wt_name
      wt_name=$(basename "$path")
      echo "cd $path && printf '\\033]0;%s\\007' '$wt_name' && claude --resume $session_id" \
        > "$cmd_dir/cmd-$i.txt"
    fi
    ((i++)) || true
  done < <(super -f csv -c 'unnest this | cut path, session_id' "$manifest" | tail -n +2)

  if [[ -n "${CLAUDE_TABS_DRY_RUN:-}" ]]; then
    return 0
  fi

  # Batch restore via single AppleScript invocation
  build_restore_applescript "$cmd_dir" "$count" | osascript

  # Cleanup temp dir (only if we created it)
  if [[ -z "${CLAUDE_TABS_CMD_DIR:-}" ]]; then
    rm -rf "$cmd_dir"
  fi
}

# ─────────────────────────────────────────────────────────────────────────────
# Main (skipped when sourced)
# ─────────────────────────────────────────────────────────────────────────────

# Guard: when sourced, define functions but don't run main
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
  return 0 2>/dev/null || true
fi

usage() {
  echo "Usage: claude-tabs <command>"
  echo ""
  echo "Commands:"
  echo "  save          Save running Claude sessions to the manifest"
  echo "  restore       Reopen the sessions in the manifest"
  echo "  list-active   Show currently running sessions (dry-run of save)"
  echo "  list-saved    Show the saved manifest (what restore will reopen)"
  echo ""
  echo "Manifest: $CLAUDE_TABS_MANIFEST"
  echo "Every save is also archived (timestamped) under:"
  echo "  $CLAUDE_TABS_HISTORY_DIR"
}

case "${1:-}" in
  save)        cmd_save ;;
  restore)     shift; cmd_restore "$@" ;;
  list-active) cmd_list_active ;;
  list-saved)  cmd_list_saved ;;
  -h|--help)   usage ;;
  *)
    usage
    exit 1
    ;;
esac
