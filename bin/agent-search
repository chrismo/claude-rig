#!/usr/bin/env bash
#
# claude-search - Search Claude prompt history by keyword
#
# Usage: claude-search <term> [days]
#
# Searches ~/.claude/projects/*/*.jsonl session transcripts for user prompts
# whose content matches <term> (case-insensitive regex). Limits results to the
# last N days (default: 30). Prints date, project, sessionId, and an 89-char
# excerpt as a barred table.
#
# Use the sessionId with `claude --resume <sessionId>` to resume a session.
#
# Date filter uses UTC. Excludes meta entries, compact-summary continuations,
# and tool-result messages so only real user prompts are returned.
#
# Requires: super (SuperDB), grdy.
#

set -euo pipefail
shopt -s nullglob

usage() {
  cat <<-EOF
	Usage: claude-search <term> [days]

	Searches ~/.claude/projects/*/*.jsonl for user prompts matching <term>
	(case-insensitive). Defaults to last 30 days.

	Examples:
	  claude-search fivetran
	  claude-search "redis snapshot" 7
	EOF
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" || -z "${1:-}" ]]; then
  usage
  exit 0
fi

term="$1"
days="${2:-30}"
projects_dir="${CLAUDE_SEARCH_PROJECTS_DIR:-$HOME/.claude/projects}"

files=("$projects_dir"/*/*.jsonl)
if [[ ${#files[@]} -eq 0 ]]; then
  echo "No session files found under $projects_dir" >&2
  exit 1
fi

super -j -c "
  where type=='user'
    and not has(isMeta)
    and not has(isCompactSummary)
    and typeof(message.content) == <string>
    and cast(timestamp, <time>) >= now() - '${days}d'::duration
    and grep('(?i)${term}', cast(message.content, <string>))
  | values {
      date: strftime('%Y-%m-%d %H:%M', cast(timestamp, <time>)),
      project: split(cwd, '/')[-1],
      sessionId,
      prompt: replace(cast(message.content, <string>)[0:89], '\n', ' ')
    }
  | sort -r date
" "${files[@]}" | grdy
