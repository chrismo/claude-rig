#!/usr/bin/env bash
#
# claude-pod - Show another Claude session's conversation as readable turns
#
# Usage:
#   claude-pod [path]                     # most-recent session in worktree (default: $PWD)
#   claude-pod --all [path]               # list sessions in worktree, newest first
#   claude-pod --peers [path]             # like --all but excludes the current Claude
#   claude-pod --session <id-or-name>     # show a specific session by ID or rename-name
#   claude-pod --console [path]           # the human's terminal recording for that worktree
#   claude-pod --record [path]            # print the command that starts such a recording
#
# Render flags (apply to default and --session modes):
#   --turns N                         # render only the last N readable turns
#   --since <when>                    # render turns at/after <when>:
#                                     #   ISO 8601 (2026-05-14T14:30:00Z)
#                                     #   relative duration (30m, 1h, 2d, 90s)
#   --follow, -f                      # after historical render, stream new turns
#                                     # as they're appended (Ctrl-C to stop)
#
# Selection flags (apply to default, --all, and --peers modes):
#   --exclude <id-or-name>            # skip this session (repeatable)
#
# Worktree mode resolves $path → ~/.claude/projects/<encoded-path>/ and picks the
# .jsonl with the newest mtime (the active or most recently active session).
# Path encoding mirrors Claude's: every '/' becomes '-'.
#
# Session names: if a session has been given a name via /rename, listings show
# it in a 'name' column and --session/--exclude accept it in place of the UUID.
# Names are sourced from ~/.claude/sessions/<pid>.json for live sessions, with
# a fallback to the latest "Session renamed to:" event in the .jsonl for exited
# sessions.
#
# Output is one block per turn (user prompts + assistant text), oldest-first.
# Tool calls, tool results, thinking blocks, and meta entries are filtered out.
#
# Token-economics note for Claude observers:
#   --follow streams every new turn → high token cost when used by a Claude
#   instance. For Claude-driven observation, prefer polling with --since
#   <last-read-ts> on a controlled cadence. --follow is intended for humans
#   watching in a terminal pane (zero tokens).
#
# The human is a peer too. When they run
#   script -F -q .my-console.log
# in their own terminal, everything they see — test runs, server output, stack
# traces — lands in that file, live (-F flushes on every write). --console reads
# it back; --record prints the command to start one. Claude cannot start the
# recording itself: script(1) has to wrap the human's interactive shell, not a
# tool-call subshell.
#
# script(1) typescripts are raw terminal output: ANSI color, OSC title-set
# sequences, carriage-return progress redraws, its own "Script started on"
# banner. --console strips all of that, so what reaches a reader is roughly what
# a human's eye resolved on screen.
#
# Requires: super (SuperDB), perl (console cleaning).
#

set -euo pipefail
shopt -s nullglob

# Silence SIGPIPE write errors when output is piped to head/less/etc.
trap '' PIPE

# Console recordings live at the worktree root, one per terminal pane, named
# .<tag>-console.log — .main-console.log, .tests-console.log, .server-console.log.
# The tag is how a pane is addressed (--tag tests) and how it's labelled on read.
#
# CONSOLE_GLOB is both the discovery pattern and a valid gitignore line: one entry
# in the global excludes file means every log claude-pod can find is already
# ignored, in every repo, with no per-repo .gitignore edit ever. It's deliberately
# looser than the .<tag>-console.log convention so an off-convention name (an old
# .my-console.log, say) is still found rather than silently invisible.
CONSOLE_GLOB=".*console*.log"
DEFAULT_CONSOLE_TAG="main"

# How much of each pane --console hands back by default. A day's typescript is
# enormous and every line costs a reader tokens. Applied per pane, so adding a
# quiet server pane can't blow up the cost of reading the busy one.
DEFAULT_TAIL=200

# The window a --new read falls back to the first time it sees a stream, before a
# cursor exists. Deliberately small: a first read is orientation, not archaeology.
DEFAULT_NEW_TURNS=10

usage() {
  cat <<-EOF
	Usage: claude-pod <path> [flags]
	       claude-pod --all [path] [flags]
	       claude-pod --peers [path] [flags]
	       claude-pod --session <id-or-name> [render flags]
	       claude-pod --console-list [path]
	       claude-pod --console [path] [--tag T] [--tail N] [-f]
	       claude-pod --record [path] [--tag T]

	Selection:
	  <path>                 most-recent session in that worktree
	  --all [path]           list sessions in worktree, newest first
	  --peers [path]         like --all but excludes \$CLAUDE_CODE_SESSION_ID
	  --session <id-or-name> show a specific session by UUID or /rename name
	  --exclude <id-or-name> skip this session (repeatable; with --all/--peers)

	Render flags:
	  --new                only what arrived since THIS reader last looked. Works on
	                       sessions and consoles; keeps a cursor per (reader, stream).
	                       The cheap way to keep up — --turns/--tail re-read history
	                       you already paid for.
	  --turns N            render only the last N readable turns (per-session;
	                       not valid with --all/--peers)
	  --since <when>       ISO 8601 timestamp or relative duration (30m, 2h, 1d)
	  --follow, -f         stream new turns. Per-session: render historical then
	                       follow. With --all/--peers: firehose — interleave new
	                       turns from every matched session, tagged by short sid.

	The human's consoles (their terminals, recorded with script -F -q).
	One pane per concern, each in .<tag>-console.log at the worktree root:
	  --console-list [path]  what's recording: tag, modified, lines
	  --console [path]       read every pane, ANSI/redraw-stripped, each headed
	                         by its tag; oldest-written pane first
	  --tag T                with --console: just that pane
	                         with --record: name the pane being started
	  --tail N               with --console: last N lines per pane (default $DEFAULT_TAIL)
	  --record [path]        print the command the human runs to start a recording
	                         (Claude can't: script(1) needs a tty)

	Examples:
	  claude-pod .
	  claude-pod --peers
	  claude-pod --session ee28f782-247b-4c7e-88c4-11417fa87154 --turns 20
	  claude-pod --session axon-staging-19 --since 30m   # name set via /rename
	                                                     # cross-worktree
	  claude-pod -f --since 5m .                          # human terminal watcher
	  claude-pod --peers -f                               # firehose all peers
	  claude-pod --console-list                           # which panes are recording
	  claude-pod --console --tail 80                      # what the human just saw
	  claude-pod --console --tag tests                    # only the test pane
	  claude-pod --console --tag tests --new              # …only what's new since I looked
	  claude-pod --peers --new                            # what peers said since I looked
	  claude-pod --record --tag server                    # how they start a pane
	EOF
}

projects_dir="${CLAUDE_PROJECTS_DIR:-$HOME/.claude/projects}"

# ── Read cursors ───────────────────────────────────────────────────────────────
#
# Catching up on a peer stream with --tail/--turns re-reads what this reader has
# already seen, so the more often it checks, the more it pays to re-read its own
# history. A cursor makes catch-up cost O(new output) instead.
#
# Cursors are per (reader, stream): two Claudes following the same peer each keep
# their own idea of "what's new for me". The reader is $CLAUDE_CODE_SESSION_ID
# inside Claude Code; a plain shell shares one cursor namespace, which is fine —
# a human's `--new` is curiosity, not bookkeeping.
#
# The stored value differs by stream: a byte offset for a console typescript, the
# timestamp of the last rendered turn for a session .jsonl.
cursor_dir="${CLAUDE_POD_CURSOR_DIR:-$HOME/.claude/claude-pod/cursors}"
reader_id="${CLAUDE_CODE_SESSION_ID:-shell}"

cursor_file() {
  local key="${1//\//-}"
  echo "$cursor_dir/$reader_id/$key"
}

cursor_get() {
  local f
  f="$(cursor_file "$1")"
  [[ -f "$f" ]] || return 0
  cat "$f"
}

cursor_set() {
  local f
  f="$(cursor_file "$1")"
  mkdir -p "${f%/*}"
  printf '%s\n' "$2" > "$f"
}

# Claude Code names a project dir by replacing EVERY non-alphanumeric character in
# the absolute path with '-', not just the slashes. The leading '/' becomes the
# leading '-' for free.
#
# Getting this wrong is a silent false negative — under a path like
#   /Users/me/Library/CloudStorage/GoogleDrive-chris.morris@dscout.com/My Drive/rig
# a '/'-only substitution keeps the '.', '@' and space, points at a directory that
# was never created, and reports "no sessions" while peers are actively running
# (issue #17). Sanitize the same way Claude does, or don't find anything.
encode_path() {
  printf '%s' "$1" | sed 's/[^a-zA-Z0-9]/-/g'
}

project_dir_for() {
  local path
  path="$(cd "$1" 2>/dev/null && pwd)" || {
    echo "claude-pod: not a directory: $1" >&2
    exit 1
  }
  local encoded
  encoded="$(encode_path "$path")"
  echo "$projects_dir/$encoded"
}

is_excluded() {
  # Guard the array expansion: bash 3.2 (macOS) + `set -u` errors on
  # `"${EXCLUDES[@]}"` when the array is empty.
  [[ ${#EXCLUDES[@]} -eq 0 ]] && return 1
  local sid="$1"
  local ex
  for ex in "${EXCLUDES[@]}"; do
    [[ "$sid" == "$ex" ]] && return 0
  done
  return 1
}

# Session names (set via /rename) live in two places:
#  1. ~/.claude/sessions/<pid>.json — for currently-running sessions
#  2. The session's .jsonl, recorded as the local_command stdout
#     "Session renamed to: NAME" — survives after the session exits
# We try (1) first, then fall back to (2).

sessions_meta_dir="${CLAUDE_SESSIONS_META_DIR:-$HOME/.claude/sessions}"

# sessionId<TAB>name lines for every live session that has a /rename name.
# Built lazily with one super call across all metadata files so per-session
# lookups are an in-memory string match. Bash 3.2 has no associative arrays,
# so we keep the cache as a TSV string and walk it.
SID_NAME_MAP_TSV=""
SID_NAME_MAP_LOADED=0

load_sid_name_map() {
  [[ "$SID_NAME_MAP_LOADED" -eq 1 ]] && return 0
  SID_NAME_MAP_LOADED=1
  local files=("$sessions_meta_dir"/*.json)
  [[ -e "${files[0]:-}" ]] || return 0
  SID_NAME_MAP_TSV=$(
    super -i json -f line -c \
      "where has(name) and has(sessionId) | values f'{sessionId}\t{name}'" \
      "${files[@]}" 2>/dev/null
  ) || true
}

# Look up a session's name from the live sessions metadata directory.
# Emits the name to stdout; exits 1 if not found.
name_from_live_sessions() {
  load_sid_name_map
  [[ -n "$SID_NAME_MAP_TSV" ]] || return 1
  local sid="$1" line
  while IFS= read -r line; do
    if [[ "$line" == "$sid"$'\t'* ]]; then
      echo "${line#*$'\t'}"
      return 0
    fi
  done <<< "$SID_NAME_MAP_TSV"
  return 1
}

# Reverse lookup: name → sessionId from the live sessions metadata directory.
sid_from_live_sessions() {
  load_sid_name_map
  [[ -n "$SID_NAME_MAP_TSV" ]] || return 1
  local target="$1" line
  while IFS= read -r line; do
    if [[ "$line" == *$'\t'"$target" ]]; then
      echo "${line%%$'\t'*}"
      return 0
    fi
  done <<< "$SID_NAME_MAP_TSV"
  return 1
}

# Cache of /rename names recorded in session .jsonl files across all
# worktrees. Built lazily with one super call so name lookups (forward and
# reverse) are an in-memory walk regardless of how many sessions exist.
#
# Actual rename events have type=='system' and subtype=='local_command', with
# the name in `content` wrapped in <local-command-stdout>…</local-command-stdout>
# tags. Filtering on type+subtype prevents false matches from tool results,
# code reads, or assistant turns that contain the literal phrase
# "Session renamed to:". `has(subtype)` guards against records whose schema
# lacks the field (super errors on direct missing-field access).
SID_NAME_DISK_MAP_TSV=""
SID_NAME_DISK_MAP_LOADED=0

load_sid_name_disk_map() {
  [[ "$SID_NAME_DISK_MAP_LOADED" -eq 1 ]] && return 0
  SID_NAME_DISK_MAP_LOADED=1
  local files=("$projects_dir"/*/*.jsonl)
  [[ -e "${files[0]:-}" ]] || return 0
  SID_NAME_DISK_MAP_TSV=$(
    super -i json -f line -c "
      where type == 'system' and has(subtype) and subtype == 'local_command'
        and grep('Session renamed to:', this)
      | put _name := regexp('Session renamed to: ([^<]+)', cast(this, <string>))[1]
      | sort -r timestamp
      | summarize ns := collect(_name) by sessionId
      | values f'{sessionId}\t{ns[0]}'
    " "${files[@]}" 2>/dev/null
  ) || true
}

# Forward lookup: sessionId → name from the on-disk rename map.
name_from_disk_map() {
  load_sid_name_disk_map
  [[ -n "$SID_NAME_DISK_MAP_TSV" ]] || return 1
  local sid="$1" line
  while IFS= read -r line; do
    if [[ "$line" == "$sid"$'\t'* ]]; then
      echo "${line#*$'\t'}"
      return 0
    fi
  done <<< "$SID_NAME_DISK_MAP_TSV"
  return 1
}

# Reverse lookup: name → sessionId from the on-disk rename map. Scans every
# worktree, so this is the cross-worktree fallback for `--session <name>`.
sid_from_disk_map() {
  load_sid_name_disk_map
  [[ -n "$SID_NAME_DISK_MAP_TSV" ]] || return 1
  local target="$1" line
  while IFS= read -r line; do
    if [[ "$line" == *$'\t'"$target" ]]; then
      echo "${line%%$'\t'*}"
      return 0
    fi
  done <<< "$SID_NAME_DISK_MAP_TSV"
  return 1
}

session_name_for() {
  local sid="$1"
  local name
  name="$(name_from_live_sessions "$sid" 2>/dev/null || true)"
  if [[ -z "$name" ]]; then
    name="$(name_from_disk_map "$sid" 2>/dev/null || true)"
  fi
  echo "$name"
}

is_uuid() {
  [[ "$1" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]
}

# Resolve an argument that is either a session UUID or a /rename name into a
# UUID. Searches live sessions first (cheap), then the on-disk rename map
# (covers every worktree). Cross-worktree by design — a name set anywhere on
# this machine will resolve.
resolve_session_id() {
  local arg="$1"
  if is_uuid "$arg"; then
    echo "$arg"
    return 0
  fi
  local sid
  if sid=$(sid_from_live_sessions "$arg"); then
    echo "$sid"
    return 0
  fi
  if sid=$(sid_from_disk_map "$arg"); then
    echo "$sid"
    return 0
  fi
  echo "claude-pod: no session matching name: $arg" >&2
  return 1
}

filtered_sessions_in() {
  local dir="$1"
  local files=("$dir"/*.jsonl)
  if [[ ${#files[@]} -eq 0 ]]; then
    return 1
  fi
  local f sid f_mtime
  while IFS= read -r f; do
    sid="${f##*/}"
    sid="${sid%.jsonl}"
    is_excluded "$sid" && continue
    if [[ -n "${SINCE_EPOCH:-}" ]]; then
      f_mtime=$(stat -f '%m' "$f")
      [[ $f_mtime -ge $SINCE_EPOCH ]] || continue
    fi
    echo "$f"
  done < <(ls -t "${files[@]}")
}

list_sessions() {
  local target="${1:-$PWD}"
  local dir
  dir="$(project_dir_for "$target")"
  # Bad path / never-used worktree is an error (the user pointed somewhere
  # Claude has never run). But "directory exists, just no sessions match the
  # window" is a normal answer — exit 0.
  if [[ ! -d "$dir" ]]; then
    echo "claude-pod: no Claude sessions for $target" >&2
    echo "  expected: $dir" >&2
    exit 1
  fi
  # Pre-load the name maps in the parent shell. Each `name=$(session_name_for …)`
  # runs in a subshell that can read but not write parent variables; without
  # this, every row would rebuild the disk map from scratch (multi-second
  # super query per row).
  load_sid_name_map
  load_sid_name_disk_map
  local any=0
  while IFS= read -r f; do
    if [[ $any -eq 0 ]]; then
      printf '%-19s  %-36s  %-5s  %s\n' 'modified' 'sessionId' 'turns' 'name'
    fi
    any=1
    local sid mtime turns name
    sid="${f##*/}"
    sid="${sid%.jsonl}"
    mtime=$(stat -f '%Sm' -t '%Y-%m-%d %H:%M:%S' "$f")
    turns=$(wc -l < "$f" | tr -d ' ')
    name=$(session_name_for "$sid")
    printf '%-19s  %-36s  %-5s  %s\n' "$mtime" "$sid" "$turns" "$name"
  done < <(filtered_sessions_in "$dir")
  if [[ $any -eq 0 ]]; then
    echo "claude-pod: no matching sessions in $dir" >&2
  fi
}

find_by_session_id() {
  local sid="$1"
  local matches=("$projects_dir"/*/"$sid".jsonl)
  if [[ ${#matches[@]} -eq 0 ]]; then
    echo "claude-pod: no session file for ID $sid" >&2
    exit 1
  fi
  echo "${matches[0]}"
}

# Translate a --since value (ISO 8601 or relative duration) to a super expression.
since_expr() {
  local v="$1"
  if [[ "$v" =~ ^[0-9]+[smhd]$ ]]; then
    echo "now() - '${v}'::duration"
  else
    # Treat as ISO 8601. Super will error on bad input.
    echo "cast('${v}', <time>)"
  fi
}

# Translate a --since value to a Unix epoch threshold (for mtime filtering).
# Delegates parsing to super, which handles durations and ISO 8601 natively.
# Super returns errors as values (not exit codes), so we detect and surface them.
since_to_epoch() {
  local v="$1"
  local expr
  if [[ "$v" =~ ^[0-9]+(\.[0-9]+)?[smhdwy]$ ]]; then
    expr="cast(now() - '$v'::duration, <int64>) / 1000000000"
  else
    expr="cast(cast('$v', <time>), <int64>) / 1000000000"
  fi
  local result
  result=$(super -f line -c "$expr")
  if [[ "$result" == error\(* ]]; then
    echo "claude-pod: invalid --since value: $v" >&2
    echo "  super: $result" >&2
    exit 2
  fi
  echo "$result"
}

# Core filter+normalize pipeline shared by historical and follow rendering.
# Emits {ts, role, text} records, oldest-first when sourced from a finite file.
#
# message.content is either a plain string (simple user prompts) or an array of
# content blocks (tool use, mixed text/images). We coerce strings into a
# one-element array of {type:'text', text:...} so a single unnest path handles
# both shapes. An earlier `switch` design hit a SuperDB quirk where the
# unnest-branch was evaluated against string rows even when the type guard
# routed them to the other case.
filter_pipeline() {
  local since_clause=""
  if [[ -n "${SINCE:-}" ]]; then
    since_clause=" and cast(timestamp, <time>) >= $(since_expr "$SINCE")"
  fi
  # A cursor is exclusive where --since is inclusive: the turn at the cursor is
  # the last one already rendered, so re-emitting it would double-charge the
  # reader for output it has seen.
  if [[ -n "${CURSOR_TS:-}" ]]; then
    since_clause+=" and cast(timestamp, <time>) > cast('$CURSOR_TS', <time>)"
  fi
  cat <<EOF
where type in ['user','assistant'] and not has(isMeta)${since_clause}
| put _arr := case
    when typeof(message.content) == <string>
      then [{type: 'text', text: cast(message.content, <string>)}]
      else message.content
    end
| put text := (unnest _arr | where this.type == 'text' | values this.text | collect(this))
| where len(text) > 0
| values {ts: timestamp, role: type, text: join(text, '\n')}
EOF
}

# Format a {ts, role, text} record stream as readable blocks.
format_clause() {
  echo "| values f'{strftime(\"%Y-%m-%d %H:%M\", cast(ts, <time>))}  [{role}]\n{text}\n'"
}

render_historical() {
  local file="$1"
  local order_clause
  if [[ -n "${TURNS:-}" ]]; then
    # Sort desc, take N, then sort asc for chronological output.
    order_clause="| sort -r ts | head $TURNS | sort ts"
  else
    order_clause="| sort ts"
  fi
  super -f line -c "$(filter_pipeline) $order_clause $(format_clause)" "$file"
}

# The timestamp of the newest readable turn in a session — what a cursor stores.
# Computed from the unfiltered stream, so it advances past the last turn the
# reader actually saw even when a window (--turns) clipped the render.
last_turn_ts() {
  local file="$1"
  CURSOR_TS="" SINCE="" super -f line -c "
    where type in ['user','assistant'] and not has(isMeta)
    | sort -r timestamp
    | head 1
    | values cast(timestamp, <string>)
  " "$file" 2>/dev/null || true
}

# Only the turns added to this session since this reader last looked. Same three
# edges as the console path: no cursor → fall back to the window rather than
# replaying the whole conversation; nothing new → say so rather than printing
# nothing at all.
render_session_new() {
  local file="$1"
  local sid="${file##*/}"
  sid="${sid%.jsonl}"

  local cursor first_read=0
  cursor="$(cursor_get "$sid")"
  if [[ -z "$cursor" ]]; then
    first_read=1
    TURNS="${TURNS:-$DEFAULT_NEW_TURNS}"
  else
    CURSOR_TS="$cursor"
    TURNS=""
  fi

  local out
  out="$(render_historical "$file")"

  local newest
  newest="$(last_turn_ts "$file")"
  [[ -n "$newest" ]] && cursor_set "$sid" "$newest"

  if [[ -z "$out" ]]; then
    echo "[$sid] no new turns since last read"
    return 0
  fi
  if [[ "$first_read" -eq 1 ]]; then
    echo "[$sid] first read — last $TURNS turns"
  fi
  printf '%s\n' "$out"
}

render_follow() {
  local file="$1"
  # Stream appends through the same filter pipeline (no sort — append order is
  # already chronological). -n 0 means start from end (don't re-emit history).
  tail -f -n 0 "$file" | super -i json -f line -c "$(filter_pipeline) $(format_clause)"
}

# Variant of filter_pipeline that keeps sessionId in the output. Used by the
# multi-session firehose so each turn can be tagged with its source.
filter_pipeline_with_sid() {
  local since_clause=""
  if [[ -n "${SINCE:-}" ]]; then
    since_clause=" and cast(timestamp, <time>) >= $(since_expr "$SINCE")"
  fi
  cat <<EOF
where type in ['user','assistant'] and not has(isMeta)${since_clause}
| put _arr := case
    when typeof(message.content) == <string>
      then [{type: 'text', text: cast(message.content, <string>)}]
      else message.content
    end
| put text := (unnest _arr | where this.type == 'text' | values this.text | collect(this))
| where len(text) > 0
| values {ts: timestamp, role: type, sid: sessionId, text: join(text, '\n')}
EOF
}

format_clause_with_sid() {
  # Short sid (first 8 chars) keeps the prefix readable. Full sid is in the
  # listing if you need to disambiguate.
  echo "| values f'{strftime(\"%Y-%m-%d %H:%M\", cast(ts, <time>))}  [{role} {sid[0:8]}]\n{text}\n'"
}

# Stream-everything follow: tail -qf all matched files together, interleaved.
# Output is annotated with a short sessionId prefix so turns from different
# sessions can be told apart. `-q` suppresses the per-file ==> headers that
# tail would otherwise emit when output switches files.
render_follow_all() {
  local files=("$@")
  [[ ${#files[@]} -gt 0 ]] || return 0
  tail -qf -n 0 "${files[@]}" | super -i json -f line -c "$(filter_pipeline_with_sid) $(format_clause_with_sid)"
}

# ── The human's console ────────────────────────────────────────────────────────

# A recording that ended and one being written to right now are the same bytes on
# disk. macOS `script -q` leaves no marker either way — no "Script started on",
# no "Script done on" (that's exactly what -q suppresses; util-linux differs). So
# liveness is a question about processes, not content: is a script(1) still
# holding the file open?
#
# One lsof call covers every pane (~300ms); doing it per file would trip over the
# same cost repeatedly. Filtering on the `script` command matters — a human
# tailing their own log holds it open too, and that isn't a recording.
#
# Populates LIVE_CONSOLES, a newline-delimited set of paths. Anything lsof can't
# tell us about is treated as ended: claiming "live" wrongly would invite a reader
# to trust a stale log, and that's the failure this whole distinction exists to
# prevent.
LIVE_CONSOLES=""
load_live_consoles() {
  [[ $# -gt 0 ]] || return 0
  LIVE_CONSOLES=$(
    lsof -Fcn -- "$@" 2>/dev/null | awk '
      /^c/ { cmd = substr($0, 2) }
      /^n/ { if (cmd == "script") print substr($0, 2) }
    ' | sort -u
  ) || true
}

# lsof answers with physical paths (/private/var/…), while ours are logical
# (/var/…) whenever any parent is a symlink — true of /tmp and /var on macOS.
# Comparing the two as strings silently reports a live pane as ended, so resolve
# ours the same way before matching.
physical_path() {
  local dir
  dir="$(cd "$(dirname "$1")" 2>/dev/null && pwd -P)" || {
    echo "$1"
    return 0
  }
  echo "$dir/${1##*/}"
}

console_is_live() {
  [[ -n "$LIVE_CONSOLES" ]] || return 1
  local target line
  target="$(physical_path "$1")"
  while IFS= read -r line; do
    [[ "$line" == "$target" ]] && return 0
  done <<< "$LIVE_CONSOLES"
  return 1
}

console_status() {
  if console_is_live "$1"; then echo "live"; else echo "ended"; fi
}

# "2m ago", "3h ago", "6d ago" — coarse on purpose. The question a reader has is
# "is this from the work I'm doing now, or from Tuesday?", not the exact second.
console_age() {
  local mtime now delta
  mtime=$(stat -f '%m' "$1")
  now=$(date +%s)
  delta=$((now - mtime))
  ((delta < 0)) && delta=0
  if ((delta < 60)); then
    echo "just now"
  elif ((delta < 3600)); then
    echo "$((delta / 60))m ago"
  elif ((delta < 86400)); then
    echo "$((delta / 3600))h ago"
  else
    echo "$((delta / 86400))d ago"
  fi
}

# .tests-console.log → tests. Off-convention names degrade gracefully rather than
# being dropped: .my-console.log → my, .console.log → console.
console_tag_for() {
  local b="${1##*/}"
  b="${b#.}"
  b="${b%.log}"
  b="${b%-console}"
  b="${b#console-}"
  [[ -n "$b" ]] || b="console"
  echo "$b"
}

# Every console recording in a worktree, oldest-written first — so when they're
# rendered in order, the pane the human touched most recently lands last, nearest
# the reader's attention. $CLAUDE_CONSOLE_LOG, if set, is the only console there
# is (absolute, or relative to the worktree). Empty output means "none" — not an
# error here; callers decide what that means.
console_files() {
  local dir="$1"
  if [[ -n "${CLAUDE_CONSOLE_LOG:-}" ]]; then
    local p="$CLAUDE_CONSOLE_LOG"
    [[ "$p" == /* ]] || p="$dir/$p"
    [[ -f "$p" ]] && echo "$p"
    return 0
  fi
  # Unquoted on purpose: CONSOLE_GLOB is a pattern and must expand here.
  # shellcheck disable=SC2206
  local candidates=("$dir"/$CONSOLE_GLOB)
  [[ ${#candidates[@]} -eq 0 ]] && return 0
  ls -tr "${candidates[@]}" 2>/dev/null
}

# The subset of console_files matching $TAG (all of them when TAG is empty).
# Exits 1 — naming the tags that do exist — when a tag matches nothing, because
# a silent empty read looks exactly like "that pane had nothing to say".
selected_console_files() {
  local dir="$1"
  local f files=() tags=""
  while IFS= read -r f; do
    [[ -n "$f" ]] || continue
    if [[ -z "$TAG" || "$(console_tag_for "$f")" == "$TAG" ]]; then
      files+=("$f")
    fi
    tags+=" $(console_tag_for "$f")"
  done < <(console_files "$dir")

  if [[ ${#files[@]} -eq 0 && -n "$TAG" ]]; then
    echo "claude-pod: no console recording tagged '$TAG' in $dir" >&2
    if [[ -n "$tags" ]]; then
      echo "  recording:$tags" >&2
    fi
    exit 1
  fi
  [[ ${#files[@]} -eq 0 ]] && return 0
  printf '%s\n' "${files[@]}"
}

# Reduce a raw script(1) typescript to what a human's eye actually resolved on
# screen: no escape sequences, no intermediate frames of a progress redraw, no
# banner, no long runs of blank lines. Line-buffered ($|) so --follow streams.
clean_console() {
  perl -ne '
    BEGIN { $| = 1; $blank = 0 }
    next if /^Script (started|done) on /;
    s/\e\][^\a\e]*(?:\a|\e\\)//g;          # OSC — window/tab title sets
    s/\e\[[0-9;?]*[ -\/]*[\@-~]//g;        # CSI — color, cursor motion
    s/\e[()][AB0-2]//g;                    # charset selects
    s/\e[=>78Mc]//g;                       # misc two-byte escapes
    s/\r+(?=\n)//g;                        # CRLF → LF
    s/^.*\r//;                             # redraw: last write to the line wins
    s/[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]//g; # leftover control bytes
    if (/^\s*$/) { next if $blank++ } else { $blank = 0 }
    print;
  '
}

# One pane, under a heading that names it and dates it. The heading is
# unconditional — even with a single pane — so a reader is never left inferring
# which terminal it's looking at, nor whether that terminal is still alive. An
# "ended, 6d ago" pane is history; read it as history.
render_console_file() {
  local file="$1"
  local n="${TAIL:-$DEFAULT_TAIL}"
  printf '── %s  (%s, %s, last write %s)\n' \
    "$(console_tag_for "$file")" \
    "${file##*/}" \
    "$(console_status "$file")" \
    "$(console_age "$file")"
  tail -n "$n" "$file" | clean_console
}

# Only what's been appended to this pane since this reader last looked.
#
# Three edges decide whether this is trustworthy:
#  - No cursor yet → fall back to the window. A first read must not dump a whole
#    day of terminal history into a context window.
#  - Cursor past EOF → the pane was re-recorded. `script` truncates on start, so
#    this is routine, not corruption. Reset and say so; otherwise a restarted pane
#    would read as "nothing new" forever.
#  - Nothing appended → say so out loud. "No new output" and "I didn't look" must
#    not produce identical silence.
render_console_new() {
  local file="$1"
  local n="${TAIL:-$DEFAULT_TAIL}"
  local key size offset
  key="$(physical_path "$file")"
  size=$(stat -f '%z' "$file")
  offset="$(cursor_get "$key")"

  printf '── %s  (%s, %s, last write %s)\n' \
    "$(console_tag_for "$file")" \
    "${file##*/}" \
    "$(console_status "$file")" \
    "$(console_age "$file")"

  if [[ -z "$offset" ]]; then
    echo "   [first read — showing the last $n lines]"
    tail -n "$n" "$file" | clean_console
    cursor_set "$key" "$size"
    return 0
  fi

  if ((offset > size)); then
    echo "   [pane was re-recorded since the last read — reading from the start]"
    offset=0
  fi

  if ((offset == size)); then
    echo "   [no new output since last read]"
    return 0
  fi

  # Cap the delta at the same window: a pane that exploded while nobody was
  # looking must not be able to blow the context window open.
  tail -c "+$((offset + 1))" "$file" | clean_console | tail -n "$n"
  cursor_set "$key" "$size"
}

render_consoles() {
  local files=("$@")
  load_live_consoles "${files[@]}"
  local i
  for i in "${!files[@]}"; do
    [[ $i -eq 0 ]] || echo
    if [[ "$NEW" -eq 1 ]]; then
      render_console_new "${files[$i]}"
    else
      render_console_file "${files[$i]}"
    fi
  done
}

# --follow is single-pane only. Interleaving several typescripts would produce a
# stream nobody could attribute: script(1) writes no timestamps (macOS `script -t`
# is a flush interval, not util-linux's timing log), and raw appends carry no
# marker of which pane they came from.
render_console_follow() {
  local file="$1"
  local n="${TAIL:-$DEFAULT_TAIL}"
  printf '── %s  (%s)\n' "$(console_tag_for "$file")" "${file##*/}"
  tail -n "$n" -f "$file" | clean_console
}

list_consoles() {
  local dir="$1"
  local f files=()
  while IFS= read -r f; do
    [[ -n "$f" ]] && files+=("$f")
  done < <(console_files "$dir")

  if [[ ${#files[@]} -eq 0 ]]; then
    echo "claude-pod: no console recording in $dir" >&2
    echo "  the human starts one in their terminal with: claude-pod --record" >&2
    return 0
  fi

  load_live_consoles "${files[@]}"
  printf '%-12s  %-6s  %-11s  %-7s  %s\n' 'tag' 'status' 'last write' 'lines' 'file'
  for f in "${files[@]}"; do
    printf '%-12s  %-6s  %-11s  %-7s  %s\n' \
      "$(console_tag_for "$f")" \
      "$(console_status "$f")" \
      "$(console_age "$f")" \
      "$(wc -l < "$f" | tr -d ' ')" \
      "${f##*/}"
  done
}

# Claude can't start the recording — script(1) has to wrap the human's own
# interactive shell, and a tool-call subshell isn't one (it has no tty; script
# dies with "tcgetattr/ioctl: Operation not supported on socket"). So hand the
# human the command and let them run it.
print_record_command() {
  local target="${1:-$PWD}"
  local dir
  dir="$(cd "$target" 2>/dev/null && pwd)" || {
    echo "claude-pod: not a directory: $target" >&2
    exit 1
  }

  local tag="${TAG:-$DEFAULT_CONSOLE_TAG}"
  local logname=".$tag-console.log"

  # Only warn about *this* pane's log. A running server pane is not a reason to
  # hesitate before recording the test pane.
  if [[ -f "$dir/$logname" ]]; then
    echo "Note: $logname already exists — script truncates on start, so this"
    echo "overwrites it. Use 'script -F -q -a' to append to the old one instead."
    echo
  fi

  local logpath="$logname"
  [[ "$dir" == "$PWD" ]] || logpath="$dir/$logname"

  echo "Run this in the terminal you want recorded — script(1) has to wrap an"
  echo "interactive shell, so Claude can't start it for you:"
  echo
  echo "    script -F -q $logpath"
  echo
  echo "Work as usual; exit (or Ctrl-D) ends the recording."
  echo "One pane per concern: --record --tag tests, --tag server, …"
  echo "Claude reads it back with: claude-pod --console [--tag $tag]"

  if git -C "$dir" rev-parse --git-dir >/dev/null 2>&1 &&
    ! git -C "$dir" check-ignore -q "$dir/$logname" 2>/dev/null; then
    echo
    echo "Heads-up: $logname isn't gitignored here. One line in your global"
    echo "excludes covers every repo, forever — it's the same glob claude-pod"
    echo "discovers by, so anything it can read is already ignored:"
    echo
    echo "    echo '$CONSOLE_GLOB' >> \$(git config --global core.excludesfile)"
  fi
}

MODE=worktree
POSITIONAL=""
SESSION_ID=""
EXCLUDES=()
TURNS=""
TAIL=""
TAG=""
SINCE=""
FOLLOW=0
NEW=0
CURSOR_TS=""

# Bare invocation prints usage. Rendering the most-recent session "by default"
# was too magical — easy to surprise yourself in the wrong worktree.
if [[ $# -eq 0 ]]; then
  usage
  exit 0
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --all)
      MODE=list
      shift
      ;;
    --peers)
      MODE=list
      [[ -n "${CLAUDE_CODE_SESSION_ID:-}" ]] || {
        echo "claude-pod: --peers requires \$CLAUDE_CODE_SESSION_ID (only set inside Claude Code); use --all from a regular shell" >&2
        exit 2
      }
      EXCLUDES+=("$CLAUDE_CODE_SESSION_ID")
      shift
      ;;
    --session)
      MODE=session
      SESSION_ID="${2:?--session requires a sessionId}"
      shift 2
      ;;
    --exclude)
      EXCLUDES+=("${2:?--exclude requires a sessionId}")
      shift 2
      ;;
    --console)
      MODE=console
      shift
      ;;
    --console-list)
      MODE=console-list
      shift
      ;;
    --record)
      MODE=record
      shift
      ;;
    --tag)
      TAG="${2:?--tag requires a console tag}"
      shift 2
      ;;
    --new)
      NEW=1
      shift
      ;;
    --turns)
      TURNS="${2:?--turns requires a number}"
      [[ "$TURNS" =~ ^[0-9]+$ ]] || { echo "claude-pod: --turns must be a non-negative integer" >&2; exit 2; }
      shift 2
      ;;
    --tail)
      TAIL="${2:?--tail requires a number}"
      [[ "$TAIL" =~ ^[0-9]+$ ]] || { echo "claude-pod: --tail must be a non-negative integer" >&2; exit 2; }
      shift 2
      ;;
    --since)
      SINCE="${2:?--since requires a timestamp or duration}"
      shift 2
      ;;
    -f|--follow)
      FOLLOW=1
      shift
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "claude-pod: unknown flag: $1" >&2
      exit 2
      ;;
    *)
      [[ -z "$POSITIONAL" ]] || {
        echo "claude-pod: too many positional args" >&2
        exit 2
      }
      POSITIONAL="$1"
      shift
      ;;
  esac
done

# --turns counts conversation turns, so it means nothing across a listing or over
# a console recording (which has lines, not turns — that's --tail).
# --follow IS valid with --all/--peers: it streams new turns from every matched
# session interleaved ("firehose" mode).
if [[ -n "$TURNS" && "$MODE" != "worktree" && "$MODE" != "session" ]]; then
  echo "claude-pod: --turns is a session render flag; not valid with --all/--peers/--console" >&2
  exit 2
fi

if [[ -n "$TAIL" && "$MODE" != "console" ]]; then
  echo "claude-pod: --tail only applies to --console (sessions use --turns)" >&2
  exit 2
fi

if [[ -n "$TAG" && "$MODE" != "console" && "$MODE" != "record" ]]; then
  echo "claude-pod: --tag names a console pane; only valid with --console/--record" >&2
  exit 2
fi

# Pre-validate --since once; fail fast before any rendering or listing runs.
if [[ -n "$SINCE" ]]; then
  SINCE_EPOCH=$(since_to_epoch "$SINCE")
fi

# Resolve names → UUIDs for --session and --exclude (positional was already
# parsed, so project_dir_for can use it as the worktree fallback for names).
if [[ -n "$SESSION_ID" ]]; then
  SESSION_ID=$(resolve_session_id "$SESSION_ID")
fi
if [[ ${#EXCLUDES[@]} -gt 0 ]]; then
  resolved=()
  for ex in "${EXCLUDES[@]}"; do
    resolved+=("$(resolve_session_id "$ex")")
  done
  EXCLUDES=("${resolved[@]}")
fi

# Sets $RENDER_FILE to the .jsonl to render, or empty if the worktree has
# no matching sessions (a non-error empty answer — e.g. "no peer activity in
# the last 10m"). Hard errors (bad path, unknown session id) exit non-zero
# from helpers, so we don't need to signal them here.
RENDER_FILE=""
resolve_render_file() {
  case "$MODE" in
    session)
      RENDER_FILE=$(find_by_session_id "$SESSION_ID")
      ;;
    worktree)
      local target dir
      target="${POSITIONAL:-$PWD}"
      dir="$(project_dir_for "$target")"
      if [[ ! -d "$dir" ]]; then
        echo "claude-pod: no Claude sessions for $target" >&2
        echo "  expected: $dir" >&2
        exit 1
      fi
      RENDER_FILE=$(filtered_sessions_in "$dir" | head -n 1)
      if [[ -z "$RENDER_FILE" ]]; then
        echo "claude-pod: no matching sessions in $dir" >&2
      fi
      ;;
  esac
}

case "$MODE" in
  record)
    print_record_command "${POSITIONAL:-$PWD}"
    ;;
  console-list)
    target="${POSITIONAL:-$PWD}"
    dir="$(cd "$target" 2>/dev/null && pwd)" || {
      echo "claude-pod: not a directory: $target" >&2
      exit 1
    }
    list_consoles "$dir"
    ;;
  console)
    target="${POSITIONAL:-$PWD}"
    dir="$(cd "$target" 2>/dev/null && pwd)" || {
      echo "claude-pod: not a directory: $target" >&2
      exit 1
    }
    # Command substitution, not process substitution: selected_console_files
    # exits non-zero on an unknown --tag, and that status has to reach us.
    selected_out="$(selected_console_files "$dir")" || exit $?
    console_files_selected=()
    while IFS= read -r f; do
      [[ -n "$f" ]] && console_files_selected+=("$f")
    done <<< "$selected_out"

    if [[ ${#console_files_selected[@]} -eq 0 ]]; then
      # Unlike an empty session window, this isn't a normal answer — nothing is
      # recording, so there is nothing to wait for. Say how to fix it.
      echo "claude-pod: no console recording in $dir" >&2
      echo "  the human starts one in their terminal with: claude-pod --record" >&2
      exit 1
    fi

    if [[ "$FOLLOW" -eq 1 ]]; then
      if [[ ${#console_files_selected[@]} -gt 1 ]]; then
        echo "claude-pod: --follow needs a single pane — script(1) records no" >&2
        echo "  timestamps, so several typescripts can't be interleaved readably." >&2
        echo "  pick one with --tag (see: claude-pod --console-list)" >&2
        exit 2
      fi
      render_console_follow "${console_files_selected[0]}"
    else
      render_consoles "${console_files_selected[@]}"
    fi
    ;;
  list)
    if [[ "$FOLLOW" -eq 1 || "$NEW" -eq 1 ]]; then
      target="${POSITIONAL:-$PWD}"
      dir="$(project_dir_for "$target")"
      if [[ ! -d "$dir" ]]; then
        echo "claude-pod: no Claude sessions for $target" >&2
        echo "  expected: $dir" >&2
        exit 1
      fi
      files=()
      while IFS= read -r f; do
        files+=("$f")
      done < <(filtered_sessions_in "$dir")
      if [[ ${#files[@]} -eq 0 ]]; then
        echo "claude-pod: no matching sessions in $dir" >&2
        exit 0
      fi
      if [[ "$NEW" -eq 1 ]]; then
        # Catch up on every peer at once: each session gets its own cursor, so
        # this returns only what each has said since this reader last looked.
        for f in "${files[@]}"; do
          render_session_new "$f"
        done
      else
        # Firehose mode: stream new turns from every matched session interleaved.
        render_follow_all "${files[@]}"
      fi
    else
      list_sessions "${POSITIONAL:-$PWD}"
    fi
    ;;
  *)
    resolve_render_file
    [[ -z "$RENDER_FILE" ]] && exit 0
    file="$RENDER_FILE"
    if [[ "$NEW" -eq 1 ]]; then
      render_session_new "$file"
    elif [[ "$TURNS" != "0" ]]; then
      # --turns 0 means "no history" — skip the historical render.
      render_historical "$file"
    fi
    if [[ "$FOLLOW" -eq 1 ]]; then
      render_follow "$file"
    fi
    ;;
esac
