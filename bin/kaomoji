# Single-word aliases. Kept to one word, no hyphens, and none may collide with
# a real mood name — tests enforce all three.
declare -A SYNONYMS=(
  [mad]=rage           [angry]=rage         [pissed]=rage        [furious]=rage
  [meh]=shrug          [whatever]=shrug     [idk]=shrug          [eh]=shrug
  [bummed]=sad         [down]=sad           [blue]=sad           [cry]=sad
  [argh]=table-flip    [ugh]=table-flip     [ragequit]=table-flip
  [calm]=table-unflip  [fixed]=table-unflip
  [smirk]=smug         [lenny]=smug         [cool]=smug          [sunglasses]=smug
  [glad]=happy         [joy]=happy          [yay]=excited        [woo]=excited
  [hype]=excited       [pumped]=excited
  [sleepy]=tired       [exhausted]=tired    [beat]=tired         [zzz]=tired
  [huh]=confused       [what]=confused      [wat]=confused       [puzzled]=confused
  [heart]=love         [adore]=love         [affection]=love
  [kitty]=cat          [meow]=cat           [bearhug]=bear
  [party]=celebrate    [win]=celebrate      [shipped]=celebrate  [success]=celebrate
  [tgif]=friday        [weekend]=friday
  [focused]=determined [ready]=determined   [letsgo]=determined
  [whoops]=oops        [yikes]=oops         [uhoh]=oops          [sorry]=oops
  [bail]=strut         [outtahere]=strut    [leaving]=strut      [bye]=strut
  [swagger]=strut      [groove]=strut       [onward]=strut
)

# --- helpers ----------------------------------------------------------------

mood_names() {
  printf '%s\n' "${!MOODS[@]}" | sort
}

synonym_pairs() {
  local a
  for a in "${!SYNONYMS[@]}"; do
    printf '%s %s\n' "$a" "${SYNONYMS[$a]}"
  done | sort
}

synonyms_of() {
  synonym_pairs | awk -v m="$1" '$2 == m { print $1 }' | sort | tr '\n' ' '
}

# The grouped catalog: mood in the left column, faces flowing to the right,
# wrapping onto continuation rows under a blank mood column.
#
# Deliberately does NOT measure display width. These faces mix wide CJK
# (┻━┻ is 3 chars but 6 columns) with combining marks (乁( ⁰͡ Ĺ̯ ⁰͡ )ㄏ is 14
# chars but far fewer columns), so ${#var} would misalign either way. Fixed
# faces-per-row keeps it pure bash; the right edge is ragged by design.
CATALOG_PER_ROW=4

mood_catalog() {
  local m faces n line first=1 width=0

  # Derive the mood column from the longest name (+2 gutter) rather than
  # hardcoding it, so a new longer mood can't silently collide with the faces.
  # Mood names are ASCII, so ${#m} is honest here even though it isn't for faces.
  while read -r m; do
    (( ${#m} > width )) && width=${#m}
  done < <(mood_names)
  local CATALOG_MOOD_WIDTH=$((width + 2))
  while read -r m; do
    (( first )) || printf '\n'
    first=0

    n=0
    line=""
    while IFS= read -r face; do
      [ -n "$face" ] || continue
      if (( n == 0 )); then
        line=$(printf '%-*s%s' "$CATALOG_MOOD_WIDTH" "$m" "$face")
      elif (( n % CATALOG_PER_ROW == 0 )); then
        printf '%s\n' "$line"
        line=$(printf '%-*s%s' "$CATALOG_MOOD_WIDTH" "" "$face")
      else
        line+="  $face"
      fi
      n=$((n + 1))
    done < <(faces_for "$m")
    printf '%s\n' "$line"
  done < <(mood_names)
}

# Mood names with their aliases in parens, column-aligned. Moods with no
# aliases get no empty parens.
mood_table() {
  local m aliases width=0
  while read -r m; do
    (( ${#m} > width )) && width=${#m}
  done < <(mood_names)

  while read -r m; do
    aliases=$(synonyms_of "$m")
    aliases="${aliases% }"
    if [[ -n "$aliases" ]]; then
      printf '%-*s  (%s)\n' "$width" "$m" "$aliases"
    else
      printf '%s\n' "$m"
    fi
  done < <(mood_names)
}

# Resolve a user-supplied mood word to one or more real mood names, printed one
# per line. Exact name wins; then an exact synonym; then substring-anywhere,
# which may match several moods (their faces get pooled). Prints nothing when
# there is no match at all.
resolve_moods() {
  local want="$1"

  if [[ -n "${MOODS[$want]+set}" ]]; then
    printf '%s\n' "$want"
    return
  fi

  if [[ -n "${SYNONYMS[$want]+set}" ]]; then
    printf '%s\n' "${SYNONYMS[$want]}"
    return
  fi

  # Substring over mood names, then over synonyms (mapped to their targets),
  # so `rag` finds rage and `angr` finds angry -> rage.
  {
    mood_names | grep -F -- "$want" || true
    synonym_pairs | awk -v w="$want" 'index($1, w) { print $2 }'
  } | sort -u
}

faces_for() {
  local mood="$1"
  printf '%s\n' "${MOODS[$mood]}" | grep -v '^[[:space:]]*$'
}

all_faces() {
  local mood
  while read -r mood; do
    faces_for "$mood"
  done < <(mood_names)
}

mood_exists() {
  [[ -n "${MOODS[$1]+set}" ]]
}

usage() {
  cat <<'EOF'
usage: kaomoji [MOOD] [COUNT]        summon a face, copy it
       kaomoji <view> [MOOD]         browse without copying

summoning:
  MOOD      pick from a specific mood; omit for any mood
  COUNT     how many, default 1. All of them are copied, space-delimited
            on one line. A bare number, either order: `kaomoji happy 5`

browsing (never touches the clipboard):
  moods     every mood with its aliases
  faces     every mood's faces, grouped -- or just MOOD's with `faces sad`
  synonyms  the alias -> mood table
  names     bare mood names, one per line, for scripting

A view word works in either position: `kaomoji faces sad` == `kaomoji sad faces`.

MOOD matching: an exact mood name wins, then an exact synonym (mad -> rage),
then substring anywhere. A partial that hits several moods pools all their
faces, so `kaomoji table` draws from table-flip and table-unflip both.

examples:
  kaomoji              one face, any mood
  kaomoji shrug        one shrug
  kaomoji mad          one rage face (alias)
  kaomoji happy 5      five candidates, all copied space-delimited
  kaomoji moods        what can I ask for?
  kaomoji faces sad    show me the sad ones
EOF
}

# --- arg parsing ------------------------------------------------------------

count=1
count_set=""
mode=summon
mood=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    # Documented surface is bare words (see usage). The --flag spellings are
    # undocumented back-compat for anything already typed or scripted.
    -l|--list) mode=moods_table; shift ;;
    --all) mode=all; shift ;;
    --synonyms) mode=synonyms; shift ;;
    --moods) mode=names; shift ;;
    --catalog) mode=faces; shift ;;
    -n)
      [[ $# -ge 2 ]] || { echo "kaomoji: -n needs a number" >&2; exit 2; }
      count="$2"; count_set=1; shift 2
      ;;
    -*) echo "kaomoji: unknown option $1" >&2; usage >&2; exit 2 ;;
    # Bare-word views, usable in either position: `kaomoji faces sad` or
    # `kaomoji sad faces`. Matched before the mood branch so they can never be
    # read as mood names; a test enforces no mood shares these names.
    moods)    mode=moods_table; shift ;;
    faces)    mode=faces; shift ;;
    synonyms) mode=synonyms; shift ;;
    names)    mode=names; shift ;;
    list)     mode=moods_table; shift ;;   # back-compat
    all)      mode=all; shift ;;           # back-compat
    # A bare number is the count, in either position: `kaomoji happy 5` or
    # `kaomoji 5 happy`. No mood is all-digits, so this is unambiguous — a
    # test enforces that.
    [0-9]*)
      [[ "$1" =~ ^[0-9]+$ ]] || {
        echo "kaomoji: no such mood: $1" >&2; exit 1
      }
      [[ -z "$count_set" ]] || { echo "kaomoji: too many counts" >&2; exit 2; }
      count="$1"; count_set=1; shift
      ;;
    *)
      [[ -z "$mood" ]] || { echo "kaomoji: too many arguments" >&2; exit 2; }
      mood="$1"; shift
      ;;
  esac
done

[[ "$count" =~ ^[0-9]+$ && "$count" -gt 0 ]] || {
  echo "kaomoji: -n needs a positive integer" >&2; exit 2
}

resolved=""
if [[ -n "$mood" ]]; then
  resolved=$(resolve_moods "$mood")
  if [[ -z "$resolved" ]]; then
    echo "kaomoji: no such mood: $mood" >&2
    echo "moods: $(mood_names | tr '\n' ' ')" >&2
    exit 1
  fi
fi

# --- modes ------------------------------------------------------------------

case "$mode" in
  # `moods` alone lists moods with their aliases; given a MOOD it narrows to
  # that mood's faces, which is what `list sad` has always done.
  moods_table)
    if [[ -n "$resolved" ]]; then
      while read -r m; do faces_for "$m"; done <<< "$resolved"
    else
      mood_table
    fi
    exit 0
    ;;
  # `faces` alone is the grouped catalog; `faces MOOD` narrows to one mood.
  faces)
    if [[ -n "$resolved" ]]; then
      while read -r m; do faces_for "$m"; done <<< "$resolved"
    else
      mood_catalog
    fi
    exit 0
    ;;
  names)
    mood_names
    exit 0
    ;;
  synonyms)
    synonym_pairs
    exit 0
    ;;
  all)
    while read -r m; do
      printf '%s:\n' "$m"
      faces_for "$m" | sed 's/^/  /'
    done < <(mood_names)
    exit 0
    ;;
esac

if [[ -n "$resolved" ]]; then
  # A partial may resolve to several moods; pool every matching mood's faces.
  pool=$(while read -r m; do faces_for "$m"; done <<< "$resolved")
else
  pool=$(all_faces)
fi

picks=$(printf '%s\n' "$pool" | sort -R | head -n "$count")

# Everything printed lands on the clipboard, space-delimited on one line.
# With the default count of 1 that is just the bare face, unpadded.
printf '%s' "$(printf '%s\n' "$picks" | paste -sd' ' -)" | pbcopy
printf '%s\n' "$picks"
